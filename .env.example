# ================================================================
# Credenciales y Configuración de Moodle Scraper (ITU UNCUYO)
# ================================================================

# Credenciales de acceso a Moodle ITU UNCUYO
MOODLE_USER=tu_usuario_aqui
MOODLE_PASSWORD=tu_contraseña_aqui

# Autenticación alternativa: Cookie de sesión MoodleSession (útil para SSO de Google/Microsoft o Captchas)
# Si se define, MOODLE_USER y MOODLE_PASSWORD no son obligatorios.
# MOODLE_SESSION_COOKIE=tu_cookie_moodlesession_aqui

# URL Base del Moodle (por defecto ITU UNCUYO)
MOODLE_BASE_URL=https://aulas.itu.uncu.edu.ar/itu/

# Directorio de descarga local para organizar el material
DOWNLOAD_DIR=./downloads

# Concurrencia y cortesía de red
# MAX_WORKERS: Cantidad de descargas simultáneas en paralelo (por defecto 3)
MAX_WORKERS=3
# REQUEST_DELAY: Retardo en segundos entre peticiones para proteger el servidor (0.0 = sin espera)
REQUEST_DELAY=0.0

# Configuración de red y timeouts (en segundos)
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CHUNK_SIZE_KB=8

# Opciones avanzadas
# OVERWRITE_EXISTING: true / false (por defecto false para acelerar y no re-descargar)
OVERWRITE_EXISTING=false

# SAVE_SECTION_SUMMARIES: true / false (guarda resumen_tema.md en cada subcarpeta)
SAVE_SECTION_SUMMARIES=true

# SAVE_CONSOLIDATED_MARKDOWN: true / false (guarda notas_y_teoria_completa.md en la raíz del curso)
SAVE_CONSOLIDATED_MARKDOWN=true
